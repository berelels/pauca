    <string name="tour_welcome_title">Benvido a Pauca</string>
    <string name="tour_welcome_body">Unha pantalla de inicio máis tranquila: só palabras, sen iconas, sen insignias vermellas. Un breve percorrido.</string>
    <string name="tour_clock_title">Reloxo e data</string>
    <string name="tour_clock_body">Toca o reloxo para as alarmas e a data para o calendario. Mantén premido para cambiar o formato, o tipo de letra, o tamaño e a posición.</string>
    <string name="tour_apps_title">As túas aplicacións</string>
    <string name="tour_apps_body">Só o que importa, cos nomes que escollas. Toca para abrir. Mantén premido para renomear, substituír ou quitar.</string>
    <string name="tour_edit_title">Editar</string>
    <string name="tour_edit_body">Engade aplicacións, crea grupos e arrastra para reordenar, mesmo dun grupo a outro.</string>
    <string name="tour_settings_title">Configuración</string>
    <string name="tour_settings_body">Todo está aquí: cores, tipos de letra, reloxo, modo concentración, xestos e idioma.</string>
    <string name="tour_theme_title">Tema</string>
    <string name="tour_theme_body">Claro, escuro, negro ou o teu fondo de pantalla, máis a cor de realce.</string>
    <string name="tour_profile_title">Perfís</string>
    <string name="tour_profile_body">Cada perfil ten as súas aplicacións: Persoal, Traballo, Noite… Toca para cambiar.</string>
    <string name="tour_focus_title">Modo concentración</string>
    <string name="tour_focus_body">Silencia as notificacións, oculta as aplicacións que distraen e pode poñer a pantalla en gris. Toca para activalo; mantén premido para configuralo.</string>
    <string name="tour_drawer_title">Todas as aplicacións</string>
    <string name="tour_drawer_body">Pasa o dedo cara arriba desde calquera sitio para ver todas as aplicacións e buscar.</string>
    <string name="tour_gestures_title">Máis xestos</string>
    <string name="tour_gestures_body">Pasa o dedo cara abaixo para as notificacións. Mantén premido o fondo para a configuración. Pasa de lado para abrir as aplicacións que escollas.</string>
    <string name="tour_buttons_title">Aínda máis limpo</string>
    <string name="tour_buttons_body">En Aparencia › Botóns podes ocultar estes botóns, ou facer que aparezan só cando tocas a parte de arriba ou de abaixo da pantalla.</string>
