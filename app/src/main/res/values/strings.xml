    <string name="focus_lite_summary">Silence your phone and let through only what you choose</string>
    <string name="profiles_hint_lite">Each profile has its own cards. Pauca Lite has room for two; Pauca has no limit.</string>
    <string name="lite_imported">Your cards and settings from Pauca Lite came along.</string>
