    <string name="tour_welcome_title">Bienvenue dans Pauca</string>
    <string name="tour_welcome_body">Un écran d\'accueil plus calme : des mots, pas d\'icônes, pas de pastilles rouges. Voici un petit tour.</string>
    <string name="tour_clock_title">Horloge et date</string>
    <string name="tour_clock_body">Touchez l\'horloge pour les alarmes et la date pour votre agenda. Maintenez appuyé pour changer le format, la police, la taille et la position.</string>
    <string name="tour_apps_title">Vos applis</string>
    <string name="tour_apps_body">Seulement l\'essentiel, avec les noms que vous choisissez. Touchez pour ouvrir. Maintenez appuyé pour renommer, remplacer ou retirer.</string>
    <string name="tour_edit_title">Modifier</string>
    <string name="tour_edit_body">Ajoutez des applis, créez des groupes et faites glisser pour réordonner, même d\'un groupe à l\'autre.</string>
    <string name="tour_settings_title">Paramètres</string>
    <string name="tour_settings_body">Tout est ici : couleurs, polices, horloge, mode concentration, gestes et langue.</string>
    <string name="tour_theme_title">Thème</string>
    <string name="tour_theme_body">Clair, sombre, noir ou votre fond d\'écran, avec la couleur d\'accent.</string>
    <string name="tour_profile_title">Profils</string>
    <string name="tour_profile_body">Chaque profil a ses propres applis : Perso, Travail, Nuit… Touchez pour changer.</string>
    <string name="tour_focus_title">Mode concentration</string>
    <string name="tour_focus_body">Coupe les notifications, masque les applis qui distraient et peut passer l\'écran en gris. Touchez pour l\'activer ; maintenez appuyé pour le configurer.</string>
    <string name="tour_drawer_title">Toutes les applis</string>
    <string name="tour_drawer_body">Balayez vers le haut n\'importe où pour voir toutes les applis et chercher.</string>
    <string name="tour_gestures_title">Autres gestes</string>
    <string name="tour_gestures_body">Balayez vers le bas pour les notifications. Maintenez le fond appuyé pour les paramètres. Balayez sur le côté pour ouvrir les applis de votre choix.</string>
    <string name="tour_buttons_title">Plus épuré encore</string>
    <string name="tour_buttons_body">Dans Apparence › Boutons, vous pouvez masquer ces boutons, ou les faire apparaître seulement quand vous touchez le haut ou le bas de l\'écran.</string>
