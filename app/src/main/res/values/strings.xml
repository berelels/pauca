    <string name="tour_welcome_title">Welcome to Pauca</string>
    <string name="tour_welcome_body">A calmer home screen: just words, no icons, no red badges. Here\'s a quick tour.</string>
    <string name="tour_clock_title">Clock and date</string>
    <string name="tour_clock_body">Tap the clock for alarms and the date for your calendar. Touch and hold to change the format, font, size and position.</string>
    <string name="tour_apps_title">Your apps</string>
    <string name="tour_apps_body">Only what matters, with the names you choose. Tap to open. Touch and hold to rename, replace or remove.</string>
    <string name="tour_edit_title">Edit</string>
    <string name="tour_edit_body">Add apps, create groups and drag to reorder, even from one group to another.</string>
    <string name="tour_settings_title">Settings</string>
    <string name="tour_settings_body">Everything is here: colors, fonts, clock, focus mode, gestures and language.</string>
    <string name="tour_theme_title">Theme</string>
    <string name="tour_theme_body">Light, dark, black or your wallpaper, plus the accent color.</string>
    <string name="tour_profile_title">Profiles</string>
    <string name="tour_profile_body">Each profile has its own apps: Personal, Work, Night… Tap to switch.</string>
    <string name="tour_focus_title">Focus mode</string>
    <string name="tour_focus_body">Silences notifications, hides distracting apps and can turn the screen gray. Tap to turn it on; touch and hold to set it up.</string>
    <string name="tour_drawer_title">All apps</string>
    <string name="tour_drawer_body">Swipe up anywhere to see every app and search.</string>
    <string name="tour_gestures_title">More gestures</string>
    <string name="tour_gestures_body">Swipe down for notifications. Touch and hold the background for settings. Swipe sideways to open the apps you pick.</string>
    <string name="tour_buttons_title">Cleaner still</string>
    <string name="tour_buttons_body">In Appearance › Buttons you can hide these buttons, or have them appear only when you tap the top or bottom of the screen.</string>
