<?xml version="1.0" encoding="utf-8"?>
<app.pauca.ui.GestureFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.HomeFragment">

    <!-- Clicado pelo toque duplo; o serviço de acessibilidade bloqueia a tela -->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_tune" />

            <TextView
                android:id="@+id/focusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/jakarta"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="modo foco · desde 14:02"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/edit_home"
                android:padding="10dp"
                android:src="@drawable/ic_edit" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/dateTimeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        tools:text="19:42"
                        tools:textSize="72sp" />

                    <LinearLayout
                        android:id="@+id/dateRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextClock
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta"
                            android:textSize="15sp"
                            tools:text="quarta-feira, 1 de outubro" />

                        <TextView
                            android:id="@+id/dateExtra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jakarta"
                            android:textSize="15sp"
                            tools:text=" · 82%" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/digest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/jakarta"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Durante o foco: 8 notificações de 3 apps"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/setDefaultLauncher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/jakarta"
                    android:padding="12dp"
                    android:text="@string/set_as_default_launcher"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/btnAppearance"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/appearance"
                android:padding="12dp"
                android:src="@drawable/ic_contrast" />

            <TextView
                android:id="@+id/profilePill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:fontFamily="@font/jakarta"
                android:gravity="center"
                android:minWidth="128dp"
                android:paddingHorizontal="24dp"
                android:textSize="15sp"
                tools:text="Pessoal" />

            <ImageView
                android:id="@+id/btnFocus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/focus_mode"
                android:padding="12dp"
                android:src="@drawable/ic_moon" />
        </FrameLayout>
    </LinearLayout>
</app.pauca.ui.GestureFrameLayout>
