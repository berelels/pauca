    <string name="tour_welcome_title">Boas-vindas ao Pauca</string>
    <string name="tour_welcome_body">Uma tela inicial mais calma: só palavras, sem ícones e sem bolinhas vermelhas. Vamos a um tour rápido.</string>
    <string name="tour_clock_title">Relógio e data</string>
    <string name="tour_clock_body">Toque no relógio para os alarmes e na data para a agenda. Toque e segure para mudar o formato, a fonte, o tamanho e a posição.</string>
    <string name="tour_apps_title">Seus apps</string>
    <string name="tour_apps_body">Só o que importa, com os nomes que você escolher. Toque para abrir. Toque e segure para renomear, trocar ou tirar.</string>
    <string name="tour_edit_title">Editar</string>
    <string name="tour_edit_body">Adicione apps, crie grupos e arraste para reordenar, até de um grupo para outro.</string>
    <string name="tour_settings_title">Ajustes</string>
    <string name="tour_settings_body">Tudo fica aqui: cores, fontes, relógio, modo foco, gestos e idioma.</string>
    <string name="tour_theme_title">Tema</string>
    <string name="tour_theme_body">Claro, escuro, preto ou o seu papel de parede, e a cor de destaque.</string>
    <string name="tour_profile_title">Perfis</string>
    <string name="tour_profile_body">Cada perfil tem os seus apps: Pessoal, Trabalho, Noite… Toque para trocar.</string>
    <string name="tour_focus_title">Modo foco</string>
    <string name="tour_focus_body">Silencia as notificações, esconde os apps que distraem e pode deixar a tela cinza. Toque para ligar; toque e segure para configurar.</string>
    <string name="tour_drawer_title">Todos os apps</string>
    <string name="tour_drawer_body">Deslize para cima em qualquer lugar para ver todos os apps e buscar.</string>
    <string name="tour_gestures_title">Mais gestos</string>
    <string name="tour_gestures_body">Deslize para baixo para as notificações. Toque e segure no fundo para os ajustes. Deslize para os lados para abrir os apps que você escolher.</string>
    <string name="tour_buttons_title">Ainda mais limpo</string>
    <string name="tour_buttons_body">Em Aparência › Botões, dá para ocultar estes botões ou fazer com que apareçam só quando você toca no topo ou na base da tela.</string>
