    <string name="tour_welcome_title">Benvenuto in Pauca</string>
    <string name="tour_welcome_body">Una schermata Home più calma: solo parole, niente icone, niente badge rossi. Ecco un breve giro.</string>
    <string name="tour_clock_title">Orologio e data</string>
    <string name="tour_clock_body">Tocca l\'orologio per le sveglie e la data per il calendario. Tieni premuto per cambiare formato, carattere, dimensione e posizione.</string>
    <string name="tour_apps_title">Le tue app</string>
    <string name="tour_apps_body">Solo ciò che conta, con i nomi che scegli. Tocca per aprire. Tieni premuto per rinominare, sostituire o rimuovere.</string>
    <string name="tour_edit_title">Modifica</string>
    <string name="tour_edit_body">Aggiungi app, crea gruppi e trascina per riordinare, anche da un gruppo all\'altro.</string>
    <string name="tour_settings_title">Impostazioni</string>
    <string name="tour_settings_body">Tutto è qui: colori, caratteri, orologio, modalità concentrazione, gesti e lingua.</string>
    <string name="tour_theme_title">Tema</string>
    <string name="tour_theme_body">Chiaro, scuro, nero o il tuo sfondo, più il colore d\'accento.</string>
    <string name="tour_profile_title">Profili</string>
    <string name="tour_profile_body">Ogni profilo ha le sue app: Personale, Lavoro, Notte… Tocca per cambiare.</string>
    <string name="tour_focus_title">Modalità concentrazione</string>
    <string name="tour_focus_body">Silenzia le notifiche, nasconde le app che distraggono e può rendere lo schermo grigio. Tocca per attivarla; tieni premuto per impostarla.</string>
    <string name="tour_drawer_title">Tutte le app</string>
    <string name="tour_drawer_body">Scorri verso l\'alto ovunque per vedere tutte le app e cercare.</string>
    <string name="tour_gestures_title">Altri gesti</string>
    <string name="tour_gestures_body">Scorri verso il basso per le notifiche. Tieni premuto lo sfondo per le impostazioni. Scorri di lato per aprire le app che scegli.</string>
    <string name="tour_buttons_title">Ancora più pulito</string>
    <string name="tour_buttons_body">In Aspetto › Pulsanti puoi nascondere questi pulsanti, o farli comparire solo quando tocchi la parte alta o bassa dello schermo.</string>
