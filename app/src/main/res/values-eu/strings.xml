    <string name="tour_welcome_title">Ongi etorri Pauca-ra</string>
    <string name="tour_welcome_body">Hasierako pantaila lasaiago bat: hitzak bakarrik, ikonorik gabe, txapel gorririk gabe. Hona hemen bisita labur bat.</string>
    <string name="tour_clock_title">Erlojua eta data</string>
    <string name="tour_clock_body">Ukitu erlojua alarmetarako eta data egutegirako. Eutsi sakatuta formatua, letra-tipoa, tamaina eta posizioa aldatzeko.</string>
    <string name="tour_apps_title">Zure aplikazioak</string>
    <string name="tour_apps_body">Axola duena bakarrik, zuk aukeratzen dituzun izenekin. Ukitu irekitzeko. Eutsi sakatuta izena aldatzeko, ordezkatzeko edo kentzeko.</string>
    <string name="tour_edit_title">Editatu</string>
    <string name="tour_edit_body">Gehitu aplikazioak, sortu taldeak eta arrastatu ordena aldatzeko, baita talde batetik bestera ere.</string>
    <string name="tour_settings_title">Ezarpenak</string>
    <string name="tour_settings_body">Dena hemen dago: koloreak, letra-tipoak, erlojua, kontzentrazio modua, keinuak eta hizkuntza.</string>
    <string name="tour_theme_title">Gaia</string>
    <string name="tour_theme_body">Argia, iluna, beltza edo zure horma-papera, eta nabarmentze-kolorea.</string>
    <string name="tour_profile_title">Profilak</string>
    <string name="tour_profile_body">Profil bakoitzak bere aplikazioak ditu: Pertsonala, Lana, Gaua… Ukitu aldatzeko.</string>
    <string name="tour_focus_title">Kontzentrazio modua</string>
    <string name="tour_focus_body">Jakinarazpenak isilarazten ditu, distraitzen duten aplikazioak ezkutatzen ditu eta pantaila grisera pasa dezake. Ukitu aktibatzeko; eutsi sakatuta konfiguratzeko.</string>
    <string name="tour_drawer_title">Aplikazio guztiak</string>
    <string name="tour_drawer_body">Pasatu hatza gora edonon aplikazio guztiak ikusteko eta bilatzeko.</string>
    <string name="tour_gestures_title">Keinu gehiago</string>
    <string name="tour_gestures_body">Pasatu hatza behera jakinarazpenetarako. Eutsi sakatuta atzealdeari ezarpenetarako. Pasatu alboetara zuk aukeratutako aplikazioak irekitzeko.</string>
    <string name="tour_buttons_title">Are garbiago</string>
    <string name="tour_buttons_body">Itxura › Botoiak atalean botoi hauek ezkutatu ditzakezu, edo pantailaren goiko edo beheko aldea ukitzean bakarrik agertzea lortu.</string>
