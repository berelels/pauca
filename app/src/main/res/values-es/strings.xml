    <string name="tour_welcome_title">Te damos la bienvenida a Pauca</string>
    <string name="tour_welcome_body">Una pantalla de inicio más tranquila: solo palabras, sin iconos ni globos rojos. Hagamos un recorrido rápido.</string>
    <string name="tour_clock_title">Reloj y fecha</string>
    <string name="tour_clock_body">Toca el reloj para las alarmas y la fecha para el calendario. Mantén pulsado para cambiar el formato, la fuente, el tamaño y la posición.</string>
    <string name="tour_apps_title">Tus apps</string>
    <string name="tour_apps_body">Solo lo importante, con los nombres que elijas. Toca para abrir. Mantén pulsado para renombrar, cambiar o quitar.</string>
    <string name="tour_edit_title">Editar</string>
    <string name="tour_edit_body">Añade apps, crea grupos y arrastra para reordenar, incluso de un grupo a otro.</string>
    <string name="tour_settings_title">Ajustes</string>
    <string name="tour_settings_body">Todo está aquí: colores, fuentes, reloj, modo concentración, gestos e idioma.</string>
    <string name="tour_theme_title">Tema</string>
    <string name="tour_theme_body">Claro, oscuro, negro o tu fondo de pantalla, y el color de acento.</string>
    <string name="tour_profile_title">Perfiles</string>
    <string name="tour_profile_body">Cada perfil tiene sus apps: Personal, Trabajo, Noche… Toca para cambiar.</string>
    <string name="tour_focus_title">Modo concentración</string>
    <string name="tour_focus_body">Silencia las notificaciones, oculta las apps que distraen y puede poner la pantalla en gris. Toca para activarlo; mantén pulsado para configurarlo.</string>
    <string name="tour_drawer_title">Todas las apps</string>
    <string name="tour_drawer_body">Desliza hacia arriba en cualquier lugar para ver todas las apps y buscar.</string>
    <string name="tour_gestures_title">Más gestos</string>
    <string name="tour_gestures_body">Desliza hacia abajo para las notificaciones. Mantén pulsado el fondo para los ajustes. Desliza a los lados para abrir las apps que elijas.</string>
    <string name="tour_buttons_title">Aún más limpio</string>
    <string name="tour_buttons_body">En Apariencia › Botones puedes ocultar estos botones o hacer que aparezcan solo al tocar la parte superior o inferior de la pantalla.</string>
