    <string name="tour_replay">Torna a mostrar la visita guiada</string>
    <string name="tour_welcome_title">Et donem la benvinguda a Pauca</string>
    <string name="tour_welcome_body">Una pantalla d\'inici més tranquil·la: només paraules, sense icones, sense insígnies vermelles. Un petit tomb.</string>
    <string name="tour_clock_title">Rellotge i data</string>
    <string name="tour_clock_body">Toca el rellotge per a les alarmes i la data per al calendari. Mantén premut per canviar el format, el tipus de lletra, la mida i la posició.</string>
    <string name="tour_apps_title">Les teves aplicacions</string>
    <string name="tour_apps_body">Només el que importa, amb els noms que triïs. Toca per obrir. Mantén premut per canviar el nom, substituir o treure.</string>
    <string name="tour_edit_title">Edita</string>
    <string name="tour_edit_body">Afegeix aplicacions, crea grups i arrossega per reordenar, fins i tot d\'un grup a un altre.</string>
    <string name="tour_settings_title">Configuració</string>
    <string name="tour_settings_body">Tot és aquí: colors, tipus de lletra, rellotge, mode concentració, gestos i idioma.</string>
    <string name="tour_theme_title">Tema</string>
    <string name="tour_theme_body">Clar, fosc, negre o el teu fons de pantalla, a més del color d\'èmfasi.</string>
    <string name="tour_profile_title">Perfils</string>
    <string name="tour_profile_body">Cada perfil té les seves aplicacions: Personal, Feina, Nit… Toca per canviar.</string>
    <string name="tour_focus_title">Mode concentració</string>
    <string name="tour_focus_body">Silencia les notificacions, amaga les aplicacions que distreuen i pot posar la pantalla en gris. Toca per activar-lo; mantén premut per configurar-lo.</string>
    <string name="tour_drawer_title">Totes les aplicacions</string>
    <string name="tour_drawer_body">Llisca cap amunt des de qualsevol lloc per veure totes les aplicacions i cercar.</string>
    <string name="tour_gestures_title">Més gestos</string>
    <string name="tour_gestures_body">Llisca cap avall per veure les notificacions. Mantén premut el fons per a la configuració. Llisca cap als costats per obrir les aplicacions que triïs.</string>
    <string name="tour_buttons_title">Encara més net</string>
    <string name="tour_buttons_body">A Aspecte › Botons pots amagar aquests botons, o fer que apareguin només quan toques la part de dalt o de baix de la pantalla.</string>
